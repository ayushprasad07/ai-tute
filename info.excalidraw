      "link": null,
      "locked": false,
      "text": "AITute is an AI-powered learning web application designed to help students learn \nmore effectively from long-form educational content such as YouTube videos and PDFs. \nInstead of passively consuming content, users can turn any learning resource into an interactive, \nstructured, and personalized study experience.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AITute is an AI-powered learning web application designed to help students learn \nmore effectively from long-form educational content such as YouTube videos and PDFs. \nInstead of passively consuming content, users can turn any learning resource into an interactive, \nstructured, and personalized study experience.",
      "autoResize": true,
      "lineHeight": 1.25
